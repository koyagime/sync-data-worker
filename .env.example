# Database Connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# Discord Webhooks
DISCORD_CITY_WEBHOOK=https://discord.com/api/webhooks/YOUR_CITY_LEAGUE_WEBHOOK_URL
DISCORD_OTHER_WEBHOOK=https://discord.com/api/webhooks/YOUR_OTHER_EVENTS_WEBHOOK_URL

# Options
PM_NOTIFY_DRYRUN=false
RESUME_SILENT_AFTER_SECONDS=7200
HEADLESS=true
LOG_LEVEL=info
